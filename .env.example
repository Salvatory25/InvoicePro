# ==============================================================================
# INVOICEPRO — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local or expose service-role keys in VITE_* variables.
# ==============================================================================

# 1. Supabase Client Configuration (Public Anon Key ONLY — RLS enforced)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# 2. Application URL (Used for email verification, password reset & portal links)
VITE_APP_URL=http://localhost:5173

# 3. Database Adapter Mode
# - "supabase": Connect directly to Supabase PostgreSQL + Auth + Storage + Edge Functions (Production default)
# - "local": Use embedded transactional relational store with strict tenant RLS & atomic numbering (For local evaluation/testing when Supabase credentials are not yet configured)
VITE_DB_MODE=local

# ==============================================================================
# SERVER-SIDE / SUPABASE EDGE FUNCTION SECRETS
# Configure via `supabase secrets set KEY=VALUE` — NEVER prefix with VITE_
# ==============================================================================
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM_ADDRESS=billing@yourdomain.co.tz
# AI_PROVIDER=gemini
# AI_API_KEY=your-server-side-ai-api-key
# AI_MODEL=gemini-2.5-flash
# PAYMENT_WEBHOOK_SECRET=whsec_your_payment_provider_secret
# WHATSAPP_CLOUD_API_TOKEN=your_meta_whatsapp_cloud_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

